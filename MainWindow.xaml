<Window x:Class="WpfApp2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp2"
        mc:Ignorable="d"
        Title="MainWindow" Height="900" Width="600">
    
        <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="3" Margin="5,0,0,0"></StackPanel>
        <TextBox x:Name="txtNumbers" Width="550" Height="300" Grid.ColumnSpan="4"></TextBox>
        <Button x:Name="btnAdd" Width="140" Height="90" Grid.Column="0" Grid.Row="1" Click="buttonAddNumbersClick">1</Button>
        <Button x:Name="btnAdd1" Width="140" Height="90" Grid.Column="1" Grid.Row="1" Click="buttonAddNumbersClick">2</Button>
        <Button x:Name="btnAdd2" Width="140" Height="90" Grid.Column="2" Grid.Row="1" Click="buttonAddNumbersClick">3</Button>
        <Button x:Name="btnAdd3" Width="140" Height="90" Grid.Column="3" Grid.Row="1" Click="buttonAddNumbersClick">4</Button>
        <Button x:Name="btnAdd4" Width="140" Height="90" Grid.Column="0" Grid.Row="2" Click="buttonAddNumbersClick">5</Button>
        <Button x:Name="btnAdd5" Width="140" Height="90" Grid.Column="1" Grid.Row="2" Click="buttonAddNumbersClick">6</Button>
        <Button x:Name="btnAdd6" Width="140" Height="90" Grid.Column="2" Grid.Row="2" Click="buttonAddNumbersClick">7</Button>
        <Button x:Name="btnAdd7" Width="140" Height="90" Grid.Column="3" Grid.Row="2" Click="buttonAddNumbersClick">8</Button>
        <Button x:Name="btnAdd8" Width="140" Height="90" Grid.Column="0" Grid.Row="3" Click="buttonAddNumbersClick">9</Button>
        <Button x:Name="btnAdd9" Width="140" Height="90" Grid.Column="1" Grid.Row="3" Click="buttonAddNumbersClick">+</Button>
        <Button x:Name="btnAdd10" Width="140" Height="90" Grid.Column="2" Grid.Row="3" Click="buttonAddNumbersClick">-</Button>
        <Button x:Name="btnAdd11" Width="140" Height="90" Grid.Column="3" Grid.Row="3" Click="buttonAddNumbersClick">/</Button>
        <Button x:Name="btnAdd12" Width="140" Height="90" Grid.Column="0" Grid.Row="4" Click="buttonAddNumbersClick">*</Button>
        <Button x:Name="btnAdd13" Width="140" Height="90" Grid.Column="1" Grid.Row="4" Click="buttonEqualsClick">=</Button>


    </Grid>
</Window>
